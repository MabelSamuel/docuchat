# Server
NODE_ENV=development
PORT=3000

# CORS: origin allowed to call the API
FRONTEND_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://docuchat:docuchat@localhost:5432/docuchat

# Authentication (JWT_SECRET must be at least 32 characters; generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Access/refresh token signing secrets used by src/lib/tokens.ts (generate each with: openssl rand -hex 32)
JWT_ACCESS_SECRET=replace-with-a-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-token-secret

# Redis (REDIS_URL for the app; REDIS_HOST/REDIS_PORT for BullMQ queues and the cache)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Webhooks (HMAC-SHA256 signing secrets; generate each with: openssl rand -hex 32)
WEBHOOK_SECRET=replace-with-a-random-webhook-secret
EXAMPLE_WEBHOOK_SECRET=replace-with-a-random-example-webhook-secret

# OpenAI (optional for now)
OPENAI_API_KEY=

# Human-in-the-loop review queue
HITL_ENABLED=true
HITL_CONFIDENCE_THRESHOLD=0.6
HITL_MAX_QUEUE_SIZE=100
HITL_SLA_MINUTES=60

# External MCP server for the agent (optional; tools must also be allowlisted in src/config/mcp-servers.ts)
# EXTERNAL_MCP_URL=http://external-mcp-server:3001/mcp

# Integration tests (optional; fall back to placeholder IDs when unset)
# TEST_USER_ID=
# TEST_OTHER_USER_ID=
# TEST_DOCUMENT_ID=
