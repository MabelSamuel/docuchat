# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://docuchat:docuchat@localhost:5432/docuchat

# Authentication (JWT_SECRET must be at least 32 characters; generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# OpenAI (optional for now)
OPENAI_API_KEY=
